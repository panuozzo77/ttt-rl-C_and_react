.DS_Store
Thumbs.db

# Log files (can be generated anywhere)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ttt
# *.dat
# training_log.json

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# node_modules
.client/node_modules/*
.server/node_modules/*
